# Dependencies
node_modules/
web/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js build output and static export
.next/
web/.next/
out/
web/out/
.vinext/
.vercel

# Testing artifacts and reports
coverage/
playwright-report/
web/playwright-report/
test-results/
web/test-results/
web/license-reports/

# Environment files (never commit secrets)
.env*
!.env.example
!web/.env.example

# TypeScript build caches and generated declarations
*.tsbuildinfo
web/*.tsbuildinfo
web/next-env.d.ts

# Debug and runtime logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# OS and Editor metadata
.DS_Store
Thumbs.db
*.pem
.vscode/
.idea/
*.swp
*.swo

# Local private workspace data retained during relocation
/.local/
/web/.local/
